# Copy this file to `.env` and fill in your API keys.
# Do not commit your real keys to version control.

# xAI Grok — used for danger detection, summarization, chat
XAI_API_KEY=

# Alem AI (OpenAI-compatible) — used for STT (Whisper) and translation
ALEM_API_KEY_1=
ALEM_API_KEY_2=

# Optional: Alem API base and model (defaults shown below)
# ALEM_API_BASE=https://llm.alem.ai/v1
# ALEM_MODEL=gpt-3.5-turbo
